# Optional public configuration.
# Only values that are safe to expose in client-side code belong here.
# Never commit real secrets. Copy to `.env` for local development.
# Vite only exposes variables prefixed with VITE_.

# Example (optional): GitHub username used for the live repo feed.
# The portfolio works fully offline without this — static data is the fallback.
VITE_GITHUB_USER=hemanthhemanth1834-bit
